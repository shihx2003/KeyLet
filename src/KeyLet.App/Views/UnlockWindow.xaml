<ui:FluentWindow x:Class="KeyLet.App.Views.UnlockWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="解锁 KeyLet"
                 Icon="pack://application:,,,/Resources/KeyLetLogo.png"
                 Width="400"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="KeyLet · 解锁"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,12,24,24">
            <TextBlock FontSize="19"
                       FontWeight="SemiBold"
                       Text="解锁密钥库" />
            <TextBlock Margin="0,6,0,16"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       Text="请输入主密码以解密本地 data/ 密钥库。" />

            <ui:PasswordBox x:Name="MasterPasswordBox"
                            PlaceholderText="请输入密码" />

            <CheckBox x:Name="RememberUnlockCheckBox"
                      Margin="0,12,0,0"
                      Content="记住本机免密打开" />

            <TextBlock x:Name="ErrorTextBlock"
                       Margin="0,10,0,0"
                       Foreground="#FFEF4444"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Margin="0,18,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Margin="0,0,10,0"
                           Content="退出"
                           Click="CancelButton_Click" />
                <ui:Button Appearance="Primary"
                           Content="解锁"
                           IsDefault="True"
                           Click="UnlockButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
