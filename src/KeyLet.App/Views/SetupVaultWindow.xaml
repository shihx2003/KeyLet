<ui:FluentWindow x:Class="KeyLet.App.Views.SetupVaultWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="初始化 KeyLet 密钥库"
                 Icon="pack://application:,,,/Resources/KeyLetLogo.png"
                 Width="430"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="KeyLet · 初始化"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,12,24,24">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="设置主密码" />
            <TextBlock Margin="0,6,0,16"
                       Opacity="0.75"
                       TextWrapping="Wrap"
                       Text="密钥将加密保存在同级 data/ 目录，未打开软件也可凭此密码读取。" />

            <TextBlock Margin="0,0,0,6" FontWeight="Medium" Text="主密码" />
            <ui:PasswordBox x:Name="MasterPasswordBox"
                            PlaceholderText="请输入密码" />

            <TextBlock Margin="0,12,0,6" FontWeight="Medium" Text="确认密码" />
            <ui:PasswordBox x:Name="ConfirmPasswordBox"
                            PlaceholderText="再次输入" />

            <CheckBox x:Name="AutoUnlockCheckBox"
                      Margin="0,14,0,0"
                      IsChecked="True"
                      Content="本机免密打开（DPAPI）" />

            <TextBlock x:Name="ErrorTextBlock"
                       Margin="0,10,0,0"
                       Foreground="#FFEF4444"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Margin="0,18,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Margin="0,0,10,0"
                           Content="取消"
                           Click="CancelButton_Click" />
                <ui:Button Appearance="Primary"
                           Content="开始使用"
                           IsDefault="True"
                           Click="CreateButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
