<ui:FluentWindow x:Class="KeyLet.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="KeyLet"
                 Width="560"
                 Height="700"
                 MinWidth="460"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 Drop="Window_Drop"
                 DragOver="Window_DragOver"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="KeyLet · 本地 2FA 密钥匣"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <!-- 顶部搜索与操作栏 -->
        <Grid Grid.Row="1" Margin="18,6,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox x:Name="SearchTextBox"
                        Grid.Column="0"
                        PlaceholderText="搜索发行方或账号..."
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

            <ui:Button Grid.Column="1"
                       Margin="8,0,0,0"
                       Appearance="Primary"
                       Content="+ 添加"
                       ToolTip="添加或导入 2FA 密钥"
                       Click="AddAccountButton_Click" />

            <ui:Button Grid.Column="2"
                       Margin="8,0,0,0"
                       Content="屏幕扫码"
                       ToolTip="直接框选屏幕二维码导入（或按 Ctrl+V 粘贴二维码截图）"
                       Click="QuickScreenScanButton_Click" />

            <ui:Button Grid.Column="3"
                       Margin="8,0,0,0"
                       Content="设置"
                       ToolTip="主题、免密设置、剪贴板自动清理与主密码"
                       Click="SettingsButton_Click" />
        </Grid>

        <!-- 账号卡片列表 -->
        <Grid Grid.Row="2" Margin="18,0,18,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredAccounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="14,12"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    ToolTip="{Binding DefaultActionTooltip}"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制纯动态码"
                                                  Click="MenuCopyCodeOnly_Click" />
                                        <MenuItem Header="复制带前后缀完整码"
                                                  Visibility="{Binding HasAffix, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Click="MenuCopyWithAffix_Click" />
                                        <Separator />
                                        <MenuItem Header="编辑"
                                                  Click="MenuEdit_Click" />
                                        <MenuItem Header="删除"
                                                  Click="MenuDelete_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 第一行：账号信息 + 动态码与倒计时 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayTitle}" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="4"
                                                        Background="#220EA5E9"
                                                        BorderBrush="#660EA5E9"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding HasAffix, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="#FF0284C7"
                                                               FontWeight="SemiBold"
                                                               Text="已配前后缀" />
                                                </Border>
                                                <Border Margin="6,0,0,0"
                                                        Padding="6,1"
                                                        CornerRadius="4"
                                                        Background="#228B5CF6"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsDefaultWithAffix, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock FontSize="10.5"
                                                               Foreground="#FF7C3AED"
                                                               Text="默认完整" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Opacity="0.7"
                                                       Text="{Binding DisplaySubtitle}"
                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayCode}" />
                                            <TextBlock Margin="10,0,0,0"
                                                       Width="28"
                                                       TextAlignment="Right"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CountdownLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Opacity" Value="0.7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFEF4444" />
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 第二行：倒计时进度条 -->
                                    <ProgressBar Grid.Row="1"
                                                 Margin="0,8,0,8"
                                                 Height="3"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding ProgressPercentage, Mode=OneWay}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Foreground" Value="#FF0EA5E9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFEF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <!-- 第三行：可选复制模式按钮与管理操作 -->
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <ui:Button Padding="10,4"
                                                       FontSize="12"
                                                       Content="复制纯动态码"
                                                       Click="CopyCodeOnlyButton_Click" />
                                            <ui:Button Margin="6,0,0,0"
                                                       Padding="10,4"
                                                       FontSize="12"
                                                       Appearance="Primary"
                                                       Content="复制带前后缀"
                                                       Visibility="{Binding HasAffix, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Click="CopyWithAffixButton_Click" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ui:Button Padding="8,4"
                                                       FontSize="12"
                                                       Content="编辑"
                                                       Click="EditButton_Click" />
                                            <ui:Button Margin="6,0,0,0"
                                                       Padding="8,4"
                                                       FontSize="12"
                                                       Content="删除"
                                                       Click="DeleteButton_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态提示 -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsVaultEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="还没有任何 2FA 密钥" />
                <TextBlock Margin="0,6,0,14"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           Text="点击“+ 添加”、使用“屏幕扫码”，或直接拖入二维码图片 / 按 Ctrl+V 粘贴截图" />
                <ui:Button Appearance="Primary"
                           HorizontalAlignment="Center"
                           Content="立即添加第一个密钥"
                           Click="AddAccountButton_Click" />
            </StackPanel>

            <TextBlock VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Opacity="0.65"
                       Text="没有匹配当前搜索条件的账号"
                       Visibility="{Binding HasSearchNoMatch, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3"
                Padding="18,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Opacity="0.85"
                           VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right"
                           FontSize="11.5"
                           Opacity="0.55"
                           VerticalAlignment="Center"
                           Text="Shift+点击切换复制模式 · data/ 本地便携存储" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
